  "fixed_sql": [
    {
      "name": "wordlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wordlists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"source_filename\" TEXT NOT NULL, \"source_format\" TEXT NOT NULL, \"word_count\" INTEGER NOT NULL, \"imported_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "packs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"packs\" (\"id\" TEXT NOT NULL, \"wordlist_id\" TEXT NOT NULL REFERENCES wordlists (id) ON DELETE CASCADE, \"number\" INTEGER NOT NULL, \"mastery_wd\" TEXT NOT NULL, \"mastery_dw\" TEXT NOT NULL, \"passes_wd\" INTEGER NOT NULL DEFAULT 0, \"passes_dw\" INTEGER NOT NULL DEFAULT 0, \"clean_passes_wd\" INTEGER NOT NULL DEFAULT 0, \"clean_passes_dw\" INTEGER NOT NULL DEFAULT 0, \"last_pass_at_wd\" TEXT NULL, \"last_pass_at_dw\" TEXT NULL, \"mastered_at_wd\" TEXT NULL, \"mastered_at_dw\" TEXT NULL, \"last_direction\" TEXT NULL, \"learned_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"wordlist_id\", \"number\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES categories (id) ON DELETE CASCADE, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" TEXT NOT NULL, \"wordlist_id\" TEXT NOT NULL REFERENCES wordlists (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"term\" TEXT NOT NULL, \"pos\" TEXT NULL, \"pos_raw\" TEXT NULL, \"definition\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL REFERENCES packs (id), \"tone\" TEXT NULL, \"counter_intuitive\" INTEGER NOT NULL DEFAULT 0 CHECK (\"counter_intuitive\" IN (0, 1)), \"multiple_meanings\" INTEGER NOT NULL DEFAULT 0 CHECK (\"multiple_meanings\" IN (0, 1)), \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"subcategory_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"mastered_wd\" INTEGER NOT NULL DEFAULT 0 CHECK (\"mastered_wd\" IN (0, 1)), \"mastered_dw\" INTEGER NOT NULL DEFAULT 0 CHECK (\"mastered_dw\" IN (0, 1)), \"reveal_count_wd\" INTEGER NOT NULL DEFAULT 0, \"reveal_count_dw\" INTEGER NOT NULL DEFAULT 0, \"last_seen_at\" TEXT NULL, \"last_revealed_at\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"wordlist_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "pass_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pass_sessions\" (\"id\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL REFERENCES packs (id) ON DELETE CASCADE, \"direction\" TEXT NOT NULL, \"idx\" INTEGER NOT NULL, \"revealed\" TEXT NOT NULL, \"current_revealed\" INTEGER NOT NULL CHECK (\"current_revealed\" IN (0, 1)), \"pass_number\" INTEGER NOT NULL, \"started_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"pack_id\", \"direction\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"pack_size\" INTEGER NOT NULL DEFAULT 30, \"default_direction\" TEXT NOT NULL, \"learned_rule\" TEXT NOT NULL, \"show_pos\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_pos\" IN (0, 1)), \"demote_on_reveal\" INTEGER NOT NULL DEFAULT 0 CHECK (\"demote_on_reveal\" IN (0, 1)), \"theme\" TEXT NOT NULL DEFAULT 'system', \"study_buttons\" INTEGER NOT NULL DEFAULT 1 CHECK (\"study_buttons\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ui_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ui_state\" (\"id\" INTEGER NOT NULL, \"expanded_node_ids\" TEXT NOT NULL, \"selected_node_id\" TEXT NULL, \"viewer_mode\" TEXT NOT NULL DEFAULT 'card', \"tree_panel_open\" INTEGER NOT NULL DEFAULT 1 CHECK (\"tree_panel_open\" IN (0, 1)), \"gesture_hint_passes\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
